OPENAI_API_KEY=
GEMINI_API_KEY=

# local paths
YOLO_WEIGHTS=weights/best.pt
ZONES_CONFIG=zones.json
EVENT_DB=safety.db
EVIDENCE_DIR=events/evidence

# No object-storage credentials: evidence is stored on the local filesystem
# (see evidence.py). That removes an account, an upload latency and a network
# failure mode from the live demo.
